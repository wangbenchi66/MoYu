<Window x:Class="TransBrowser.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TransBrowser"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#1E1E2E"
        MouseMove="Window_MouseMove">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="40"/>
            <RowDefinition x:Name="TabBarRow" Height="32"/>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- Title Bar (Row 0) -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="#181825" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="TitleText" Text="TransBrowser"
                       Foreground="#CDD6F4" FontSize="13" VerticalAlignment="Center"
                       Margin="12,0" IsHitTestVisible="False"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnMinimize" Content="─" Width="40" Height="40"
                        Click="BtnMinimize_Click"
                        Background="Transparent" Foreground="#CDD6F4"
                        BorderThickness="0" Cursor="Hand" FontSize="12"/>
                <Button x:Name="BtnMaximize" Content="□" Width="40" Height="40"
                        Click="BtnMaximize_Click"
                        Background="Transparent" Foreground="#CDD6F4"
                        BorderThickness="0" Cursor="Hand" FontSize="12"/>
                <Button x:Name="BtnClose" Content="✕" Width="40" Height="40"
                        Click="BtnClose_Click"
                        Background="Transparent" Foreground="#CDD6F4"
                        BorderThickness="0" Cursor="Hand" FontSize="12"/>
            </StackPanel>
        </Grid>

        <!-- Tab Bar (Row 1) -->
        <Grid x:Name="TabBarPanel" Grid.Row="1" Background="#11111B">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="32"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="TabButtonsPanel" Orientation="Horizontal"/>
            </ScrollViewer>
            <Button Grid.Column="1" Content="+" Click="BtnNewTab_Click"
                    Background="Transparent" Foreground="#CDD6F4"
                    BorderThickness="0" Cursor="Hand" FontSize="16"
                    ToolTip="新建标签页"/>
        </Grid>

        <!-- URL Bar (Row 2) -->
        <Grid Grid.Row="2" Background="#1E1E2E" Margin="4,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnBack" Content="←" Width="32" Height="28"
                    Click="BtnBack_Click"
                    Background="#313244" Foreground="#CDD6F4"
                    BorderBrush="#45475A" BorderThickness="1"
                    Cursor="Hand" FontSize="14" Margin="0,0,2,0"/>
            <Button Grid.Column="1" x:Name="BtnForward" Content="→" Width="32" Height="28"
                    Click="BtnForward_Click"
                    Background="#313244" Foreground="#CDD6F4"
                    BorderBrush="#45475A" BorderThickness="1"
                    Cursor="Hand" FontSize="14" Margin="0,0,4,0"/>
            <TextBox Grid.Column="2" x:Name="TxtUrl"
                     Background="#313244" Foreground="#CDD6F4"
                     BorderBrush="#45475A" BorderThickness="1"
                     Padding="6,4" FontSize="12"
                     VerticalContentAlignment="Center"
                     KeyDown="TxtUrl_KeyDown"/>
            <Button Grid.Column="3" x:Name="BtnRefresh" Content="↻" Width="32" Height="28"
                    Click="BtnRefresh_Click"
                    Background="#313244" Foreground="#CDD6F4"
                    BorderBrush="#45475A" BorderThickness="1"
                    Cursor="Hand" FontSize="14" Margin="4,0,2,0"/>
            <Button Grid.Column="4" x:Name="BtnSettings" Content="⚙" Width="32" Height="28"
                    Click="BtnSettings_Click"
                    Background="#313244" Foreground="#CDD6F4"
                    BorderBrush="#45475A" BorderThickness="1"
                    Cursor="Hand" FontSize="14" Margin="0,0,0,0"/>
        </Grid>

        <!-- WebView Container (Row 3) -->
        <Grid x:Name="WebViewContainer" Grid.Row="3" Background="Black"/>

        <!-- Status Bar (Row 4) -->
        <Grid Grid.Row="4" Background="#11111B">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusText"
                       Foreground="#6C7086" FontSize="11"
                       VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
            <Slider Grid.Column="1" x:Name="StatusOpacitySlider"
                    Minimum="0.01" Maximum="1.0" TickFrequency="0.05"
                    IsSnapToTickEnabled="True" VerticalAlignment="Center"
                    Foreground="#89B4FA" Margin="4,0"
                    ValueChanged="StatusOpacitySlider_ValueChanged"/>
            <ResizeGrip Grid.Column="2" VerticalAlignment="Bottom"/>
        </Grid>
    </Grid>
</Window>
