<Window x:Class="TransBrowser.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TransBrowser"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseMove="Window_MouseMove">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="40"/>
            <RowDefinition x:Name="TabBarRow" Height="32"/>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- Title Bar (Row 0) -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="#FFFFFF" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="TitleText" Text="TransBrowser"
                       Foreground="#1F2937" FontSize="13" VerticalAlignment="Center"
                       Margin="12,0" IsHitTestVisible="False"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnMinimize" Content="─" Width="40" Height="40"
                        Click="BtnMinimize_Click"
                        Background="Transparent" Foreground="#1F2937"
                        BorderThickness="0" Cursor="Hand" FontSize="12"/>
                <Button x:Name="BtnMaximize" Content="□" Width="40" Height="40"
                        Click="BtnMaximize_Click"
                        Background="Transparent" Foreground="#1F2937"
                        BorderThickness="0" Cursor="Hand" FontSize="12"/>
                <Button x:Name="BtnClose" Content="✕" Width="40" Height="40"
                        Click="BtnClose_Click"
                        Background="Transparent" Foreground="#1F2937"
                        BorderThickness="0" Cursor="Hand" FontSize="12"/>
            </StackPanel>
        </Grid>

        <!-- Tab Bar (Row 1) -->
        <Grid x:Name="TabBarPanel" Grid.Row="1" Background="#F3F4F6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="32"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="TabButtonsPanel" Orientation="Horizontal"/>
            </ScrollViewer>
            <Button Grid.Column="1" Content="+" Click="BtnNewTab_Click"
                    Background="Transparent" Foreground="#1F2937"
                    BorderThickness="0" Cursor="Hand" FontSize="16"
                    ToolTip="新建标签页"/>
        </Grid>

        <!-- URL Bar (Row 2) -->
        <Grid x:Name="UrlBarGrid" Grid.Row="2" Background="#F3F4F6" Margin="4,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnBack" Content="←" Width="32" Height="28"
                    Click="BtnBack_Click"
                    Background="#FFFFFF" Foreground="#1F2937"
                    BorderBrush="#E6E9EE" BorderThickness="1"
                    Cursor="Hand" FontSize="14" Margin="0,0,2,0"/>
            <Button Grid.Column="1" x:Name="BtnForward" Content="→" Width="32" Height="28"
                    Click="BtnForward_Click"
                    Background="#FFFFFF" Foreground="#1F2937"
                    BorderBrush="#E6E9EE" BorderThickness="1"
                    Cursor="Hand" FontSize="14" Margin="0,0,4,0"/>
            <TextBox Grid.Column="2" x:Name="TxtUrl"
                     Background="#FFFFFF" Foreground="#1F2937"
                     BorderBrush="#E6E9EE" BorderThickness="1"
                     Padding="6,4" FontSize="12"
                     VerticalContentAlignment="Center"
                     KeyDown="TxtUrl_KeyDown"/>
            <Button Grid.Column="3" x:Name="BtnRefresh" Content="↻" Width="32" Height="28"
                    Click="BtnRefresh_Click"
                    Background="#FFFFFF" Foreground="#1F2937"
                    BorderBrush="#E6E9EE" BorderThickness="1"
                    Cursor="Hand" FontSize="14" Margin="4,0,2,0"/>
            <Button Grid.Column="4" x:Name="BtnSettings" Content="⚙" Width="32" Height="28"
                    Click="BtnSettings_Click"
                    Background="#FFFFFF" Foreground="#1F2937"
                    BorderBrush="#E6E9EE" BorderThickness="1"
                    Cursor="Hand" FontSize="14" Margin="0,0,0,0"/>
        </Grid>

        <!-- WebView Container (Row 3) -->
        <Grid x:Name="WebViewContainer" Grid.Row="3" Background="Transparent">
            <!-- Host for WebView2 controls that are added from code-behind -->
            <Grid x:Name="WebViewHost" Background="Transparent"/>

            <!-- New tab overlay (shown when current tab is a new-tab) -->
            <!-- Use a full-area light background and a centered white card for content -->
            <ScrollViewer x:Name="NewTabOverlay" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Background="#F1F5F9" Padding="0">
                <Grid>
                    <Border Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <Border Background="White" Opacity="1.0" CornerRadius="8" Padding="24" Width="760" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,40">
                        <StackPanel Width="720">
                        <StackPanel HorizontalAlignment="Center" Margin="0,8">
                            <TextBlock Text="🌐" FontSize="28" HorizontalAlignment="Center"/>
                            <TextBlock Text="新标签页" FontSize="18" FontWeight="Bold" Foreground="#2B6CB0" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>

                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewTabSearchBox" Grid.Column="0" Height="40" MinWidth="400" VerticalContentAlignment="Center" Padding="12"
                                     FontSize="14" Background="#FFFFFF" BorderBrush="#E6EEF9" BorderThickness="1"/>
                            <Button x:Name="NewTabOpenBtn" Grid.Column="1" Content="打开" Width="96" Height="40" Margin="8,0,0,0" Background="#1E90FF" Foreground="White" BorderThickness="0"/>
                        </Grid>

                        <TextBlock Text="内置快捷" FontSize="13" Margin="0,18,0,8" Foreground="#6B7280"/>
                        <WrapPanel HorizontalAlignment="Left">
                            <Border Width="220" Height="100" Background="#FBFDFF" CornerRadius="8" Margin="6" Padding="12" BorderBrush="#EEF2F7" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="微信读书" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Width="220" Height="100" Background="#FBFDFF" CornerRadius="8" Margin="6" Padding="12" BorderBrush="#EEF2F7" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="小红书" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Width="220" Height="100" Background="#FBFDFF" CornerRadius="8" Margin="6" Padding="12" BorderBrush="#EEF2F7" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="哔哩哔哩" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="我的网站" FontSize="13" Margin="0,18,0,8" Foreground="#6B7280"/>
                        <WrapPanel>
                            <Border Width="150" Height="80" Background="#FBFDFF" CornerRadius="8" Margin="6" Padding="8" BorderBrush="#EAEFF5" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="www.baidu.com" Foreground="#6B7280"/>
                                </StackPanel>
                            </Border>
                            <Border Width="150" Height="80" Background="Transparent" CornerRadius="8" Margin="6" Padding="8" BorderBrush="#E6E9EE" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="+" FontSize="24" Foreground="#9CA3AF"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="最近访问" FontSize="13" Margin="0,18,0,8" Foreground="#6B7280"/>
                        <StackPanel>
                            <Border Background="#FBFDFF" CornerRadius="8" Padding="10" Margin="0,6" BorderThickness="1" BorderBrush="#EEF2F7">
                                <TextBlock Text="搜索历史记录（标题或网址）" Foreground="#6B7280"/>
                            </Border>
                            <Border Background="#FBFDFF" CornerRadius="8" Padding="10" Margin="0,6" BorderThickness="1" BorderBrush="#EEF2F7">
                                <StackPanel>
                                    <TextBlock Text="焦虑的人 - 微信读书" FontWeight="Bold"/>
                                    <TextBlock Text="https://weread.qq.com/..." Foreground="#6B7280" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Status Bar (Row 4) -->
        <Grid x:Name="StatusBarGrid" Grid.Row="4" Background="#F3F4F6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusText"
                       Foreground="#6B7280" FontSize="11"
                       VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
            <Slider Grid.Column="1" x:Name="StatusOpacitySlider"
                    Minimum="0.01" Maximum="1.0" TickFrequency="0.05"
                    IsSnapToTickEnabled="True" VerticalAlignment="Center"
                    Foreground="#1E90FF" Margin="4,0"
                    ValueChanged="StatusOpacitySlider_ValueChanged"
                    Thumb.DragCompleted="StatusOpacitySlider_DragCompleted"/>
            <ResizeGrip Grid.Column="2" VerticalAlignment="Bottom"/>
        </Grid>
    </Grid>
</Window>
