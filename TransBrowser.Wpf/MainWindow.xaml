<Window x:Class="TransBrowser.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TransBrowser"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#BB000000"
        ResizeMode="NoResize"
        MinWidth="400" MinHeight="300"
        Width="1024" Height="768">

    <Window.ContextMenu>
        <ContextMenu x:Name="BrowserContextMenu">
            <MenuItem x:Name="CtxBack" Header="◀  Back" Click="CtxBack_Click"/>
            <MenuItem x:Name="CtxForward" Header="▶  Forward" Click="CtxForward_Click"/>
            <MenuItem x:Name="CtxRefresh" Header="↻  Refresh" Click="CtxRefresh_Click"/>
            <Separator/>
            <MenuItem x:Name="CtxCopyLink" Header="🔗  Copy Link" Click="CtxCopyLink_Click"/>
            <MenuItem x:Name="CtxNewTab" Header="＋  New Tab" Click="CtxNewTab_Click"/>
            <Separator/>
            <MenuItem x:Name="CtxDevTools" Header="🛠  DevTools" Click="CtxDevTools_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="RootGrid">
        <!-- Resize border grips (8 edges/corners) -->
        <!-- Top-left corner -->
        <Rectangle x:Name="GripTL" Width="12" Height="12"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Fill="Transparent" Cursor="SizeNWSE" Panel.ZIndex="10"
                   MouseLeftButtonDown="Grip_MouseLeftButtonDown" Tag="TL"/>
        <!-- Top-right corner -->
        <Rectangle x:Name="GripTR" Width="12" Height="12"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Fill="Transparent" Cursor="SizeNESW" Panel.ZIndex="10"
                   MouseLeftButtonDown="Grip_MouseLeftButtonDown" Tag="TR"/>
        <!-- Bottom-left corner -->
        <Rectangle x:Name="GripBL" Width="12" Height="12"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Fill="Transparent" Cursor="SizeNESW" Panel.ZIndex="10"
                   MouseLeftButtonDown="Grip_MouseLeftButtonDown" Tag="BL"/>
        <!-- Bottom-right corner -->
        <Rectangle x:Name="GripBR" Width="12" Height="12"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Fill="Transparent" Cursor="SizeNWSE" Panel.ZIndex="10"
                   MouseLeftButtonDown="Grip_MouseLeftButtonDown" Tag="BR"/>
        <!-- Top edge -->
        <Rectangle x:Name="GripT" Height="6" Margin="12,0"
                   HorizontalAlignment="Stretch" VerticalAlignment="Top"
                   Fill="Transparent" Cursor="SizeNS" Panel.ZIndex="10"
                   MouseLeftButtonDown="Grip_MouseLeftButtonDown" Tag="T"/>
        <!-- Bottom edge -->
        <Rectangle x:Name="GripB" Height="6" Margin="12,0"
                   HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                   Fill="Transparent" Cursor="SizeNS" Panel.ZIndex="10"
                   MouseLeftButtonDown="Grip_MouseLeftButtonDown" Tag="B"/>
        <!-- Left edge -->
        <Rectangle x:Name="GripL" Width="6" Margin="0,12"
                   HorizontalAlignment="Left" VerticalAlignment="Stretch"
                   Fill="Transparent" Cursor="SizeWE" Panel.ZIndex="10"
                   MouseLeftButtonDown="Grip_MouseLeftButtonDown" Tag="L"/>
        <!-- Right edge -->
        <Rectangle x:Name="GripR" Width="6" Margin="0,12"
                   HorizontalAlignment="Right" VerticalAlignment="Stretch"
                   Fill="Transparent" Cursor="SizeWE" Panel.ZIndex="10"
                   MouseLeftButtonDown="Grip_MouseLeftButtonDown" Tag="R"/>

        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <!-- Title bar -->
                <RowDefinition Height="34"/>
                <!-- Tab bar -->
                <RowDefinition Height="*"/>
                <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" x:Name="TitleBar"
                  Background="#1A1A1A"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="TitleText"
                           Text="TransBrowser" Foreground="#CCCCCC"
                           VerticalAlignment="Center" Margin="10,0"
                           FontSize="13" FontWeight="SemiBold"/>

                <!-- Mouse-through indicator -->
                <Border Grid.Column="1" x:Name="MouseThroughIndicator"
                        Background="#CC0000" CornerRadius="3"
                        Padding="6,2" Margin="4,4"
                        Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="CLICK-THROUGH" Foreground="White"
                               FontSize="10" FontWeight="Bold"/>
                </Border>

                <!-- Opacity slider -->
                <Slider Grid.Column="2" x:Name="OpacitySlider"
                        Width="80" Minimum="0.1" Maximum="1.0"
                        VerticalAlignment="Center" Margin="4,0"
                        Value="0.85"
                        ValueChanged="OpacitySlider_ValueChanged"
                        ToolTip="Window Opacity"
                        Foreground="#555" Background="#333"/>

                <!-- Window buttons -->
                <Button Grid.Column="3" Content="⎯" Width="36" Height="32"
                        Style="{StaticResource ChromeButtonStyle}"
                        Click="MinimizeButton_Click" ToolTip="Minimize"/>
                <Button Grid.Column="4" x:Name="MaxRestoreButton"
                        Content="□" Width="36" Height="32"
                        Style="{StaticResource ChromeButtonStyle}"
                        Click="MaxRestoreButton_Click" ToolTip="Maximize"/>
                <Button Grid.Column="5" Content="✕" Width="36" Height="32"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="CloseButton_Click" ToolTip="Close"/>
            </Grid>

            <!-- Tab bar -->
            <Grid Grid.Row="1" Background="#252525">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TabStrip" Orientation="Horizontal"/>
                </ScrollViewer>

                <Button Grid.Column="1" Content="+" Width="30" Height="30"
                        Style="{StaticResource AddTabButtonStyle}"
                        Click="AddTab_Click" ToolTip="New Tab"
                        VerticalAlignment="Center" Margin="2,0"/>
            </Grid>

            <!-- Browser content area -->
            <Border Grid.Row="2" x:Name="ContentBorder" Background="#0A0A0A"
                    MouseRightButtonUp="Content_MouseRightButtonUp">
                <ContentPresenter x:Name="TabContent"/>
            </Border>
        </Grid>
    </Grid>
</Window>
