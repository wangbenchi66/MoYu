<Window x:Class="TransBrowser.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="TransBrowser"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MinWidth="400"
        MinHeight="300"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Semi-transparent toolbar background -->
        <SolidColorBrush x:Key="ToolbarBrush" Color="#CC1E1E2E"/>
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#44FFFFFF"/>
        <SolidColorBrush x:Key="CloseHoverBrush" Color="#CCE53935"/>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CloseHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer border provides rounded corners and the drop shadow -->
    <Border CornerRadius="8" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="20" ShadowDepth="4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Toolbar -->
                <RowDefinition Height="40"/>
                <!-- URL bar -->
                <RowDefinition Height="36"/>
                <!-- WebView -->
                <RowDefinition Height="*"/>
                <!-- Status bar -->
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════════════ Toolbar ═══════════════════════ -->
            <Border Grid.Row="0"
                    Background="{StaticResource ToolbarBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App title / drag area -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="🌐" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="TransBrowser" Foreground="White"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Window controls (right side) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button x:Name="BtnMinimize"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Content="─"
                                ToolTip="最小化"
                                Click="BtnMinimize_Click"/>
                        <Button x:Name="BtnMaxRestore"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Content="□"
                                ToolTip="最大化/还原"
                                Click="BtnMaxRestore_Click"
                                Margin="2,0"/>
                        <Button x:Name="BtnClose"
                                Style="{StaticResource CloseButtonStyle}"
                                Content="✕"
                                ToolTip="关闭"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════ URL Bar ═══════════════════════ -->
            <Border Grid.Row="1" Background="{StaticResource ToolbarBrush}">
                <Grid Margin="8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Content="←"
                            ToolTip="后退"
                            Click="BtnBack_Click"
                            Margin="0,0,2,0"/>

                    <Border Grid.Column="1"
                            Background="#33FFFFFF"
                            CornerRadius="4"
                            Margin="2,0">
                        <TextBox x:Name="TxtUrl"
                                 Background="Transparent"
                                 Foreground="White"
                                 BorderThickness="0"
                                 Padding="6,3"
                                 VerticalAlignment="Center"
                                 FontSize="12"
                                 CaretBrush="White"
                                 SelectionBrush="#44FFFFFF"
                                 KeyDown="TxtUrl_KeyDown"/>
                    </Border>

                    <Button Grid.Column="2"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Content="↻"
                            ToolTip="刷新"
                            Click="BtnRefresh_Click"
                            Margin="2,0,0,0"/>

                    <Button Grid.Column="3"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Content="⚙"
                            ToolTip="设置"
                            Click="BtnSettings_Click"
                            Margin="2,0,0,0"/>
                </Grid>
            </Border>

            <!-- ═══════════════════════ WebView2 ═══════════════════════ -->
            <wv2:WebView2 x:Name="WebView"
                          Grid.Row="2"
                          DefaultBackgroundColor="Transparent"/>

            <!-- ═══════════════════════ Status Bar ═══════════════════════ -->
            <Border Grid.Row="3" Background="{StaticResource ToolbarBrush}">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               x:Name="TxtStatus"
                               Text="就绪"
                               Foreground="#AAFFFFFF"
                               FontSize="11"
                               VerticalAlignment="Center"/>

                    <!-- Opacity label -->
                    <TextBlock Grid.Column="2"
                               Text="透明度:"
                               Foreground="#AAFFFFFF"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                    <!-- Opacity slider -->
                    <Slider Grid.Column="3"
                            x:Name="SliderOpacity"
                            Minimum="0.1"
                            Maximum="1.0"
                            TickFrequency="0.05"
                            SmallChange="0.05"
                            LargeChange="0.1"
                            VerticalAlignment="Center"
                            ValueChanged="SliderOpacity_ValueChanged"/>

                    <!-- Opacity percentage label -->
                    <TextBlock Grid.Column="4"
                               x:Name="TxtOpacityValue"
                               Foreground="#AAFFFFFF"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Width="36"
                               TextAlignment="Right"
                               Margin="4,0,0,0"/>

                    <!-- Resize grip (bottom-right) -->
                    <ResizeGrip Grid.Column="5"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0"
                                Cursor="SizeNWSE"
                                MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
                </Grid>
            </Border>

            <!-- Settings Popup -->
            <Popup x:Name="SettingsPopup"
                   Grid.Row="1"
                   PlacementTarget="{Binding ElementName=BtnSettings}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="#EE1E1E2E"
                        CornerRadius="6"
                        Padding="14,10"
                        MinWidth="280">
                    <StackPanel>
                        <TextBlock Text="启动网址" Foreground="#AAFFFFFF" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtSettingsUrl"
                                 Background="#33FFFFFF"
                                 Foreground="White"
                                 BorderBrush="#44FFFFFF"
                                 BorderThickness="1"
                                 Padding="6,4"
                                 FontSize="12"
                                 CaretBrush="White"/>
                        <Button Content="保存并导航"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Background="#4400AAFF"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Click="BtnSaveSettings_Click"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
