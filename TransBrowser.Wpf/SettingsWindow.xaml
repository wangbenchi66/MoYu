<Window x:Class="TransBrowser.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="600" Width="480"
        Background="#1E1E2E" Foreground="White"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="CheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel>
                <!-- Window -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="窗口设置"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource LabelStyle}" Text="透明度"/>
                    <Slider Grid.Column="1" x:Name="OpacitySlider" Minimum="0.01" Maximum="1.0" 
                            TickFrequency="0.05" IsSnapToTickEnabled="True"
                            Foreground="#89B4FA" VerticalAlignment="Center"/>
                </Grid>
                <CheckBox Style="{StaticResource CheckStyle}" x:Name="ChkTopMost" Content="总在最前 (TopMost)"/>
                <CheckBox Style="{StaticResource CheckStyle}" x:Name="ChkShowInTaskbar" Content="显示在任务栏"/>
                <CheckBox Style="{StaticResource CheckStyle}" x:Name="ChkNoTitle" Content="无标题栏模式"/>
                <CheckBox Style="{StaticResource CheckStyle}" x:Name="ChkHoverHeader" Content="鼠标悬停显示标题栏"/>
                <CheckBox Style="{StaticResource CheckStyle}" x:Name="ChkShowTabBar" Content="显示标签栏"/>

                <!-- Browser -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="浏览器设置"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource LabelStyle}" Text="默认网址"/>
                    <TextBox Grid.Column="1" Style="{StaticResource InputStyle}" x:Name="TxtStartUrl"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource LabelStyle}" Text="User Agent"/>
                    <TextBox Grid.Column="1" Style="{StaticResource InputStyle}" x:Name="TxtUserAgent"/>
                </Grid>
                <CheckBox Style="{StaticResource CheckStyle}" x:Name="ChkAutoHide" Content="失去焦点自动隐藏"/>
                <CheckBox Style="{StaticResource CheckStyle}" x:Name="ChkNoImage" Content="屏蔽图片/视频 (NoImageMode)"/>
                <CheckBox Style="{StaticResource CheckStyle}" x:Name="ChkTransparentBg" Content="透明背景"/>
                <CheckBox Style="{StaticResource CheckStyle}" x:Name="ChkMobileMold" Content="手机模式 (MobileMold)"/>
                <CheckBox Style="{StaticResource CheckStyle}" x:Name="ChkClickThrough" Content="穿透模式"/>

                <!-- Auto Script -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="自动脚本 (每次导航完成后执行)"/>
                <TextBox Style="{StaticResource InputStyle}" x:Name="TxtAutoScript"
                         Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>

                <!-- Hotkeys -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="快捷键设置"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Boss键" Margin="0,4"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource InputStyle}" x:Name="TxtBossKey" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="透明度+" Margin="0,4"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource InputStyle}" x:Name="TxtOpacityUp" Margin="0,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="透明度-" Margin="0,4"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource InputStyle}" x:Name="TxtOpacityDown" Margin="0,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="透明度重置" Margin="0,4"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource InputStyle}" x:Name="TxtOpacityReset" Margin="0,4"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="穿透切换" Margin="0,4"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource InputStyle}" x:Name="TxtClickThrough" Margin="0,4"/>
                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="返回上页" Margin="0,4"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource InputStyle}" x:Name="TxtGoBack" Margin="0,4"/>
                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="运行JS" Margin="0,4"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource InputStyle}" x:Name="TxtRunJs" Margin="0,4"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,8">
            <Button Style="{StaticResource BtnStyle}" x:Name="BtnSave" Content="保存" Click="BtnSave_Click" Margin="0,0,8,0" Background="#89B4FA" Foreground="#1E1E2E"/>
            <Button Style="{StaticResource BtnStyle}" x:Name="BtnCancel" Content="取消" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
