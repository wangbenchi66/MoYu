<Window x:Class="TransBrowser.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="800" Width="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Loaded="SettingsWindow_Loaded">
    <Window.Resources>

        <!-- ── Toggle Switch ─────────────────────────────── -->
        <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="44" Height="22" CornerRadius="11"
                                Background="#45475A">
                            <Canvas>
                                <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White"
                                         Canvas.Top="2" Canvas.Left="2"/>
                            </Canvas>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#89B4FA"/>
                                <Setter TargetName="Knob" Property="Canvas.Left" Value="24"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Labels / Inputs / Headers ───────────────────── -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#89B4FA"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,6"/>
        </Style>

        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

    </Window.Resources>

    <Border Background="#1E1E2E" CornerRadius="8" BorderBrush="#313244" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Title bar ────────────────────────────────────── -->
            <Grid Grid.Row="0" Background="#181825"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="⚙ 设置" Foreground="#CDD6F4" FontSize="13"
                           VerticalAlignment="Center" Margin="12,0"
                           IsHitTestVisible="False"/>
                <Button x:Name="BtnClose" Content="✕" Width="38" Height="38"
                        HorizontalAlignment="Right" Click="BtnClose_Click"
                        Background="Transparent" Foreground="#CDD6F4"
                        BorderThickness="0" Cursor="Hand" FontSize="12"/>
            </Grid>

            <!-- ── Scrollable content ───────────────────────────── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,4,16,16">

                    <!-- ═══ 窗口设置 ═══ -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="窗口设置"/>

                    <!-- Opacity slider -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="42"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource LabelStyle}" Text="透明度"/>
                        <Slider Grid.Column="1" x:Name="OpacitySlider"
                                Minimum="1" Maximum="100" Value="100"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                Foreground="#89B4FA" VerticalAlignment="Center"
                                ValueChanged="OpacitySlider_ValueChanged"/>
                        <TextBlock Grid.Column="2" x:Name="OpacityValueText"
                                   Foreground="#6C7086" FontSize="11"
                                   VerticalAlignment="Center" Text="100%"
                                   TextAlignment="Right"/>
                    </Grid>

                    <!-- 2-column switch rows – window settings -->
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="总在最前"/>
                        <ToggleButton Grid.Row="0" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      x:Name="SwTopMost"
                                      Checked="SwTopMost_Changed" Unchecked="SwTopMost_Changed"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource LabelStyle}" Text="任务栏显示"/>
                        <ToggleButton Grid.Row="0" Grid.Column="4" Style="{StaticResource ToggleSwitch}"
                                      x:Name="SwShowInTaskbar"
                                      Checked="SwShowInTaskbar_Changed" Unchecked="SwShowInTaskbar_Changed"/>

                        <!-- Row 1 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="无标题栏"/>
                        <ToggleButton Grid.Row="1" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      x:Name="SwNoTitle"
                                      Checked="SwNoTitle_Changed" Unchecked="SwNoTitle_Changed"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource LabelStyle}" Text="悬停显示标题栏"/>
                        <ToggleButton Grid.Row="1" Grid.Column="4" Style="{StaticResource ToggleSwitch}"
                                      x:Name="SwHoverHeader"
                                      Checked="SwHoverHeader_Changed" Unchecked="SwHoverHeader_Changed"/>

                        <!-- Row 2 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="显示标签栏"/>
                        <ToggleButton Grid.Row="2" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      x:Name="SwShowTabBar"
                                      Checked="SwShowTabBar_Changed" Unchecked="SwShowTabBar_Changed"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource LabelStyle}" Text="失焦隐藏"/>
                        <ToggleButton Grid.Row="2" Grid.Column="4" Style="{StaticResource ToggleSwitch}"
                                      x:Name="SwAutoHide"
                                      Checked="SwAutoHide_Changed" Unchecked="SwAutoHide_Changed"/>

                        <!-- Row 3 -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="穿透模式"/>
                        <ToggleButton Grid.Row="3" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      x:Name="SwClickThrough"
                                      Checked="SwClickThrough_Changed" Unchecked="SwClickThrough_Changed"/>
                        <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource LabelStyle}" Text="软件背景透明"/>
                        <ToggleButton Grid.Row="3" Grid.Column="4" Style="{StaticResource ToggleSwitch}"
                                      x:Name="SwWindowTransparent"
                                      Checked="SwWindowTransparent_Changed" Unchecked="SwWindowTransparent_Changed"/>

                        <!-- Row 4 -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="无图模式"/>
                        <ToggleButton Grid.Row="4" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      x:Name="SwNoImage"
                                      Checked="SwNoImage_Changed" Unchecked="SwNoImage_Changed"/>
                        <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource LabelStyle}" Text="网页背景透明"/>
                        <ToggleButton Grid.Row="4" Grid.Column="4" Style="{StaticResource ToggleSwitch}"
                                      x:Name="SwTransparentBg"
                                      Checked="SwTransparentBg_Changed" Unchecked="SwTransparentBg_Changed"/>

                        <!-- Row 5 -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="灰度模式"/>
                        <ToggleButton Grid.Row="5" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      x:Name="SwGrayscale"
                                      Checked="SwGrayscale_Changed" Unchecked="SwGrayscale_Changed"/>
                        <TextBlock Grid.Row="5" Grid.Column="3" Style="{StaticResource LabelStyle}" Text="防截图模式"/>
                        <ToggleButton Grid.Row="5" Grid.Column="4" Style="{StaticResource ToggleSwitch}"
                                      x:Name="SwAntiScreenshot"
                                      Checked="SwAntiScreenshot_Changed" Unchecked="SwAntiScreenshot_Changed"/>

                        <!-- Row 6 -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="禁用窗体阴影"/>
                        <ToggleButton Grid.Row="6" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      x:Name="SwDisableShadow"
                                      Checked="SwDisableShadow_Changed" Unchecked="SwDisableShadow_Changed"/>
                        <TextBlock Grid.Row="6" Grid.Column="3" Style="{StaticResource LabelStyle}" Text="关闭最小化到托盘"/>
                        <ToggleButton Grid.Row="6" Grid.Column="4" Style="{StaticResource ToggleSwitch}"
                                      x:Name="SwCloseToTray"
                                      Checked="SwCloseToTray_Changed" Unchecked="SwCloseToTray_Changed"/>

                        <!-- Row 7 -->
                        <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="最小化时提示"/>
                        <ToggleButton Grid.Row="7" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      x:Name="SwMinimizeNotify"
                                      Checked="SwMinimizeNotify_Changed" Unchecked="SwMinimizeNotify_Changed"/>
                    </Grid>

                    <!-- ═══ 浏览器设置 ═══ -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="浏览器设置"/>

                    <!-- 手机模式 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource LabelStyle}" Text="手机模式"/>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      x:Name="SwMobileMold"
                                      Checked="SwMobileMold_Changed" Unchecked="SwMobileMold_Changed"/>
                    </Grid>

                    <!-- Default URL -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource LabelStyle}" Text="默认网址"/>
                        <TextBox Grid.Column="1" Style="{StaticResource InputStyle}" x:Name="TxtStartUrl"
                                 LostFocus="TxtStartUrl_LostFocus" KeyDown="TxtStartUrl_KeyDown"/>
                        <Button Grid.Column="2" Style="{StaticResource BtnStyle}" Content="跳转"
                                Margin="4,0,0,0" Click="BtnOpenUrl_Click"/>
                    </Grid>

                    <!-- User Agent -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource LabelStyle}" Text="User Agent"/>
                        <TextBox Grid.Column="1" Style="{StaticResource InputStyle}" x:Name="TxtUserAgent"
                                 LostFocus="TxtUserAgent_LostFocus"/>
                    </Grid>

                    <!-- ═══ 自动脚本 ═══ -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="自动脚本 (导航完成后执行)"/>
                    <TextBox Style="{StaticResource InputStyle}" x:Name="TxtAutoScript"
                             Height="68" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11"
                             LostFocus="TxtAutoScript_LostFocus"/>

                    <!-- ═══ 快捷键设置 ═══ -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="快捷键设置"/>
                    <TextBlock Foreground="#6C7086" FontSize="11" Margin="0,0,0,6"
                               Text="点击框后按下组合键即可录入，例如 Alt+Q"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Boss键 | 透明度+ -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Boss键"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource InputStyle}" x:Name="TxtBossKey"
                                 IsReadOnly="True"
                                 KeyDown="HotkeyTextBox_KeyDown"
                                 GotFocus="HotkeyTextBox_GotFocus"
                                 LostFocus="HotkeyTextBox_LostFocus"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource LabelStyle}" Text="透明度+"/>
                        <TextBox Grid.Row="0" Grid.Column="4" Style="{StaticResource InputStyle}" x:Name="TxtOpacityUp"
                                 IsReadOnly="True"
                                 KeyDown="HotkeyTextBox_KeyDown"
                                 GotFocus="HotkeyTextBox_GotFocus"
                                 LostFocus="HotkeyTextBox_LostFocus"/>

                        <!-- Row 1: 透明度- | 透明度重置 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="透明度-"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource InputStyle}" x:Name="TxtOpacityDown"
                                 IsReadOnly="True"
                                 KeyDown="HotkeyTextBox_KeyDown"
                                 GotFocus="HotkeyTextBox_GotFocus"
                                 LostFocus="HotkeyTextBox_LostFocus"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource LabelStyle}" Text="透明度重置"/>
                        <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource InputStyle}" x:Name="TxtOpacityReset"
                                 IsReadOnly="True"
                                 KeyDown="HotkeyTextBox_KeyDown"
                                 GotFocus="HotkeyTextBox_GotFocus"
                                 LostFocus="HotkeyTextBox_LostFocus"/>

                        <!-- Row 2: 穿透切换 | 返回上页 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="穿透切换"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource InputStyle}" x:Name="TxtClickThrough"
                                 IsReadOnly="True"
                                 KeyDown="HotkeyTextBox_KeyDown"
                                 GotFocus="HotkeyTextBox_GotFocus"
                                 LostFocus="HotkeyTextBox_LostFocus"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource LabelStyle}" Text="返回上页"/>
                        <TextBox Grid.Row="2" Grid.Column="4" Style="{StaticResource InputStyle}" x:Name="TxtGoBack"
                                 IsReadOnly="True"
                                 KeyDown="HotkeyTextBox_KeyDown"
                                 GotFocus="HotkeyTextBox_GotFocus"
                                 LostFocus="HotkeyTextBox_LostFocus"/>

                        <!-- Row 3: 运行JS | (empty) -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="运行JS"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource InputStyle}" x:Name="TxtRunJs"
                                 IsReadOnly="True"
                                 KeyDown="HotkeyTextBox_KeyDown"
                                 GotFocus="HotkeyTextBox_GotFocus"
                                 LostFocus="HotkeyTextBox_LostFocus"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
