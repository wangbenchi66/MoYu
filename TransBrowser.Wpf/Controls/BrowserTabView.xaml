<UserControl x:Class="TransBrowser.Wpf.Controls.BrowserTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Navigation bar -->
        <Grid Grid.Row="0" Background="#1A1A1A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="BackButton" Content="◀" Width="32" Height="28"
                    Style="{StaticResource NavButtonStyle}" Click="BackButton_Click"/>
            <Button Grid.Column="1" x:Name="ForwardButton" Content="▶" Width="32" Height="28"
                    Style="{StaticResource NavButtonStyle}" Click="ForwardButton_Click"/>
            <Button Grid.Column="2" x:Name="RefreshButton" Content="↻" Width="32" Height="28"
                    Style="{StaticResource NavButtonStyle}" Click="RefreshButton_Click"/>

            <TextBox Grid.Column="3" x:Name="UrlBox"
                     Background="#2A2A2A" Foreground="#EEEEEE"
                     BorderBrush="#444" BorderThickness="1"
                     VerticalContentAlignment="Center"
                     Padding="8,0" Margin="4,4"
                     FontSize="12"
                     KeyDown="UrlBox_KeyDown"/>

            <Button Grid.Column="4" x:Name="CloseTabButton" Content="✕" Width="28" Height="28"
                    Style="{StaticResource NavButtonStyle}" Click="CloseTab_Click"
                    Margin="2,0"/>
        </Grid>

        <!-- WebView2 host -->
        <ContentPresenter Grid.Row="1" x:Name="WebViewHost"
                          MouseRightButtonUp="WebViewHost_MouseRightButtonUp"/>
    </Grid>
</UserControl>
