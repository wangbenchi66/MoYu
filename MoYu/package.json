{
  "name": "moyu",
  "description": "摸鱼工作台",
  "private": true,
  "version": "0.0.5",
  "type": "module",
  "author": "wangbenchi66",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite",
    "dev:electron": "chcp 65001 >nul && wait-on tcp:5173 && electron .",
    "start": "electron .",
    "build": "vite build --base=./",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg"
  },
  "dependencies": {
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.9",
    "element-plus": "^2.14.7",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "build": {
    "copyright": "Copyright © 2026 wangbenchi66",
    "appId": "com.moyu_wangbenchi66.app",
    "productName": "MoYu",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json",
      "src/shared/defaultSettings.js"
    ],
    "win": {
      "icon": "public/icon.png",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "wangbenchi66",
        "repo": "MoYu"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wangbenchi66/MoYu.git"
  },
  "homepage": "https://github.com/wangbenchi66/MoYu"
}
