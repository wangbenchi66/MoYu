# .gitattributes — 统一换行符为 CRLF（Windows 项目）
#
# 策略：仓库内部存 LF，检出到工作区时转成 CRLF。
#   - 与 core.autocrlf=true 的既有行为一致，不会产生整文件 diff
#   - 显式声明优于依赖各机器的 git config（团队协作/换机器时行为一致）
#
# 为什么要写 text=auto + eol=crlf 两个：
#   text=auto  让 git 在提交时把 CRLF 规范化为 LF（避免仓库里混入 CRLF）
#   eol=crlf   让 git 在检出时把 LF 转回 CRLF（保证工作区始终是 CRLF）
* text=auto eol=crlf

# 文本类：明确要求 CRLF 工作区副本
*.js    text eol=crlf
*.cjs   text eol=crlf
*.mjs   text eol=crlf
*.ts    text eol=crlf
*.vue   text eol=crlf
*.css   text eol=crlf
*.html  text eol=crlf
*.json  text eol=crlf
*.md    text eol=crlf
*.yml   text eol=crlf
*.yaml  text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制：禁止任何换行符转换（转了会损坏文件）
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.icns  binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.exe   binary
*.dll   binary
*.dmg   binary
*.zip   binary
*.7z    binary
*.pdf   binary
*.crx   binary
*.user.js text eol=crlf

# 仅用于 diff 展示，不做转换
*.lock  -text
package-lock.json -text

# 构建产物与依赖不参与（同时也在 .gitignore 中）
dist/     export-ignore
release/  export-ignore
node_modules/ export-ignore
